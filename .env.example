# Demo behavior
DEMO_MODE=true

# Azure AI Foundry — direct model calls, not a Foundry Agent (see
# app/foundry_client.py for why). az login / Entra ID auth is blocked in
# this environment, so auth is API-key only. Get the key from the Foundry
# portal (Project > Keys), put it in your local .env (gitignored) — never
# commit it, never paste it in chat.
FOUNDRY_PROJECT_ENDPOINT=https://2862122-gaf-resource.services.ai.azure.com/api/projects/2862122-gaf
FOUNDRY_API_KEY=
# Available deployments in this Foundry project:
# gpt-5-mini, gpt-5.4-nano, and gpt-realtime-1.5. The app defaults to
# gpt-5-mini for text/vision quality; realtime voice uses the separate
# Azure OpenAI realtime config below.
GAF_MODEL=gpt-5-mini

# Telecom-POC + GAF-POC Function App (see ../telecom-poc-api/) -- only
# /api/gaf/* is used here; /api/* (telecom) is a separate route group.
GAF_API_BASE_URL=https://telecom-poc-andkaxb4hrapgfhw.southafricanorth-01.azurewebsites.net

# Where GAF product/customer/order/warranty data comes from: "local" (the
# default) reads the synthetic dataset under data/ -- no network call, no
# Azure Function App needed at all, good for offline demos. "live" hits
# GAF_API_BASE_URL above instead. See data/DEMO_DATA_GUIDE.md for what's in
# the local dataset. This only controls the DATA source -- extraction,
# classification, and answer synthesis always go through Azure AI Foundry
# (GAF_MODEL, direct API calls -- no Agent, no az login), which needs
# FOUNDRY_PROJECT_ENDPOINT/FOUNDRY_API_KEY set above.
GAF_DATA_SOURCE=local

# Realtime voice can use this Foundry project's gpt-realtime-1.5 deployment
# if these Azure OpenAI values are set. Leave blank to disable voice while
# chat/order/warranty continue to work.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=

# Self-hosted coturn TURN relay -- same VM, same coturn instance
# telecom-assistant already runs (see ../deploy/setup_vm.sh). Blank disables
# it; voice falls back to STUN-only. NOTE: as of telecom-assistant's own
# PROGRESS.md, TURN is deployed there but not yet confirmed to fix voice on
# Zscaler-managed corporate networks -- it may still fail on those networks.
TURN_SHARED_SECRET=
TURN_DOMAIN=

# Frontend (the backend quick start runs uvicorn on 8001)
VITE_API_BASE_URL=http://localhost:8001
